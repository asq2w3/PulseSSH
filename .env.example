# ============================================================================
# PulseSSH · 远程 Linux / GPU 服务器空闲度监控环境变量配置示例
# 复制此文件为 .env 并在本地填写实际参数（切勿将 .env 提交至 Git 仓库）
# ============================================================================

# Web 服务监听端口（默认 3000）
PORT=3000

# --- 远程 SSH 服务器连接配置 ---
# 服务器显示别名（展示在 Dashboard 顶部）
SSH_SERVER_ALIAS="Ubuntu-DL-Node-01"

# SSH 主机地址（IP 或域名，支持 ~/.ssh/config 中定义的 Host 别名）
SSH_HOST=""

# SSH 端口（默认 22）
SSH_PORT=22

# SSH 登录用户名
SSH_USERNAME="ubuntu"

# 认证方式：privateKeyPath（本地私钥路径）或 agent（系统 OpenSSH Agent）
SSH_AUTH_METHOD="privateKeyPath"

# 本地 SSH 私钥文件路径（支持 ~ 展开或 Windows 绝对路径，如 C:\Users\name\.ssh\id_ed25519）
SSH_PRIVATE_KEY_PATH="~/.ssh/id_ed25519"

# 私钥口令（如私钥设置了 passphrase，仅在本地后端进程内存中读取，绝不返回给前端）
SSH_PASSPHRASE=""

# --- SSH 主机密钥安全校验（禁止无条件跳过验证） ---
# 校验策略：
#   known_hosts        - 从本地 ~/.ssh/known_hosts 文件验证服务器主机公钥（默认推荐）
#   pinned_fingerprint - 校验服务器公钥 SHA256 指纹是否与 SSH_HOST_FINGERPRINT 一致
SSH_HOST_KEY_POLICY="known_hosts"

# 自定义 known_hosts 文件路径（留空则默认使用 ~/.ssh/known_hosts）
SSH_KNOWN_HOSTS_PATH="~/.ssh/known_hosts"

# 当使用 pinned_fingerprint 或补充校验时，指定服务器主机密钥 SHA256 指纹
# 获取方式：在服务器或本地执行 ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub
# 示例格式：SHA256:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SSH_HOST_FINGERPRINT=""

# --- 采集与状态判定参数 ---
# 采样间隔（毫秒，默认 5000 即 5 秒，范围 2000 ~ 60000）
MONITOR_POLL_INTERVAL_MS=5000

# SSH 握手连接超时（毫秒，默认 10000）
SSH_CONNECT_TIMEOUT_MS=10000

# 单次远程只读监控命令执行超时（毫秒，默认 8000）
SSH_COMMAND_TIMEOUT_MS=8000

# 状态判定阈值（百分比 0-100）
THRESHOLD_GPU_IDLE_MAX=15
THRESHOLD_GPU_BUSY_MIN=55
THRESHOLD_VRAM_BUSY_MIN=80
THRESHOLD_CPU_IDLE_MAX=25
THRESHOLD_CPU_BUSY_MIN=75
THRESHOLD_MEM_BUSY_MIN=85
